BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}
DB_NAME=${{Postgres.PGDATABASE}}
NODE_ENV=production
LOG_LEVEL=info
DEFAULT_REMINDER_TIME=08:00
DEFAULT_TIMEZONE=UTC
PORT=3000
# Leave WEBHOOK_URL unset to run in polling mode. Set it to switch to webhook mode
# (e.g. https://habitbot.yourdomain.com) — the bot appends /telegram-webhook itself.
WEBHOOK_URL=
