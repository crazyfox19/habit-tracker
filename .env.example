BOT_TOKEN=

# Railway-managed Postgres (preferred): paste the URL from Railway > Postgres > Variables
# Use DATABASE_URL (internal) when running on Railway; DATABASE_PUBLIC_URL when running locally.
DATABASE_URL=

# Fallback (only used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_USER=habitbuddy_user
DB_PASSWORD=
DB_NAME=habitbuddy_db
NODE_ENV=development
LOG_LEVEL=debug
DEFAULT_REMINDER_TIME=08:00
DEFAULT_TIMEZONE=UTC
